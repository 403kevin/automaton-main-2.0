# Copy to .env.soak and fill in. MONEY_MODE=live only on Kevin's yes.
# Seven-day Base Sepolia soak. Fill the blank secrets, then:
#   docker compose -f docker-compose.yml -f docker-compose.soak.yml -f docker-compose.safe.yml --env-file .env.soak up -d --build
#   docker compose -f docker-compose.yml -f docker-compose.soak.yml -f docker-compose.safe.yml --env-file .env.soak exec orchestrator node --disable-warning=ExperimentalWarning dist/index.js seed

PORT=4747
HOST=0.0.0.0
DATA_DIR=/app/data

MONEY_MODE=dry-run
NETWORK=base-sepolia
ALLOW_MAINNET=false
RPC_URL=https://sepolia.base.org
X402_SETTLEMENT=auto
X402_FACILITATOR_URL=https://x402.org/facilitator

# Required. A long random string. If you leave it blank the server generates one inside the data volume.
WALLET_MASTER_KEY=
ADMIN_TOKEN=
# Required for live mode. Your treasury, not the example burn-style address.
TREASURY_ADDRESS=
# Optional. A fresh wallet with Base Sepolia ETH. Used to broadcast x402 if you set X402_SETTLEMENT=direct,
# and to top up agent gas before a USDC sweep. The public facilitator is the free default and needs no key.
FACILITATOR_PRIVATE_KEY=
GAS_FUNDER_PRIVATE_KEY=
GAS_TOPUP_WEI=50000000000000
GAS_MIN_WEI=20000000000000

LLM_MODE=openrouter
OPENROUTER_API_KEY=
# Uncensored Dolphin on OpenRouter. Swap in a heretic slug when one is listed. Any slug is passed through.
DEFAULT_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition
LOW_COMPUTE_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition
CRITICAL_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition
COUNCIL_MODELS=cognitivecomputations/dolphin-mistral-24b-venice-edition

# Ledger rent is not an OpenRouter charge. These caps bound the OpenRouter bill.
DAILY_RENT_USD=0.05
RENT_INTERVAL_MS=86400000
GRACE_MS=21600000
NORMAL_MIN_USD=0.40
LOW_MIN_USD=0.10
AGENT_DAILY_CAP_USD=0.25
GLOBAL_DAILY_CAP_USD=0.60
INFERENCE_RESERVE_USD=0.01
COUNCIL_FEE_USD=0.01
SOAK_SEED_USD=1.50
TURN_INTERVAL_MS=300000
REPORT_INTERVAL_MS=86400000

MAX_POPULATION=6
MAX_DEPTH=2
MAX_CHILDREN=1
CHILD_ENDOWMENT_USD=0.20
REPLICATION_RESERVE_USD=0.20

SEARCH_PROVIDER=searxng
SEARXNG_URL=http://searxng:8080
SEARCH_COST_USD=0.0001

# Shared headless browser. Only the orchestrator calls it. No API key.
SENSES_URL=http://senses:7070
SEE_PAGE_PRICE_USD=0.002
SEE_PAGE_SCREENSHOT_PRICE_USD=0.003
SEE_PAGE_HOURLY_LIMIT=30
CRAWL_PAGE_PRICE_USD=0.001
CRAWL_HOURLY_LIMIT=5
CRAWL_MAX_PAGES=20
READ_FEED_PRICE_USD=0.0005
READ_FEED_HOURLY_LIMIT=60
REDDIT_USER_AGENT="AutomatonSenses/2.0 (key-free public JSON reader; no OAuth)"
# Local browser agent. Leave false for the soak. No Browser Use cloud key.
BROWSE_ENABLED=false
BROWSE_STEP_PRICE_USD=0.005
BROWSE_LLM_RESERVE_USD=0.05
BROWSE_HOURLY_LIMIT=3
BROWSE_MAX_STEPS=15
PUBLISH_PAGE_PRICE_USD=0.001
SERVE_ENDPOINT_PRICE_USD=0.002
SERVE_MIN_PRICE_USD=0.001
SERVE_MAX_PRICE_USD=1.00
HANDLER_TIMEOUT_MS=10000
HANDLER_QUEUE_TIMEOUT_MS=10000

RUNTIME=docker
AGENT_IMAGE=automaton:2
DOCKER_NETWORK=automaton_default
DOCKER_VOLUME=automaton-data
ORCHESTRATOR_URL=http://orchestrator:4747
# Comma-separated hostnames the constitution refuses for outbound fetch, shell, and browse. Matches each host and its subdomains.
CONSTITUTION_DENY_HOSTS=
