{
  "name": "automaton",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js serve",
    "demo": "tsc -p tsconfig.json --pretty false && node --disable-warning=ExperimentalWarning dist/senses-demo.js",
    "demo:survival": "node --disable-warning=ExperimentalWarning dist/index.js demo",
    "demo:check": "node --disable-warning=ExperimentalWarning dist/index.js demo --check",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "viem": "^2.38.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
