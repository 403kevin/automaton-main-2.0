# Copy to .env and change the secrets before exposing the port.
# Defaults are dry-run on Base Sepolia. Nothing here spends mainnet funds.

PORT=4747
HOST=0.0.0.0
DATA_DIR=./data

# dry-run (default) simulates USDC. live broadcasts real transfers.
MONEY_MODE=dry-run
# base-sepolia (default) or base. Mainnet also requires ALLOW_MAINNET=true.
NETWORK=base-sepolia
ALLOW_MAINNET=false
# Public RPC. Override if you have your own.
# RPC_URL=https://sepolia.base.org
# USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Encrypts every agent wallet. At least 16 characters. Never commit a real one.
WALLET_MASTER_KEY=replace-with-a-long-random-string
# Required for top-up, kill switch, clock control, and the demo client.
ADMIN_TOKEN=replace-with-another-long-random-string
# Where swept USDC goes when an agent dies. Required for MONEY_MODE=live.
TREASURY_ADDRESS=0x1111111111111111111111111111111111111111

# mock works with no key. openrouter bills the key below.
LLM_MODE=mock
OPENROUTER_API_KEY=
# Any OpenRouter model id, including abliterated "heretic" variants.
# The string is passed through unchanged.
DEFAULT_MODEL=meta-llama/llama-3.1-8b-instruct
LOW_COMPUTE_MODEL=meta-llama/llama-3.1-8b-instruct
CRITICAL_MODEL=meta-llama/llama-3.1-8b-instruct
# Example heretic / abliterated slug once you know the current id on OpenRouter:
# DEFAULT_MODEL=your-org/your-model-heretic
COUNCIL_MODELS=meta-llama/llama-3.1-8b-instruct,qwen/qwen-2.5-7b-instruct
COUNCIL_FEE_USD=0.02
INFERENCE_RESERVE_USD=0.02

# Metabolism. Rent is charged by the orchestrator, not by the agent.
DAILY_RENT_USD=0.50
RENT_INTERVAL_MS=86400000
GRACE_MS=3600000
NORMAL_MIN_USD=1.00
LOW_MIN_USD=0.25
AGENT_DAILY_CAP_USD=5.00
GLOBAL_DAILY_CAP_USD=25.00

MAX_POPULATION=12
MAX_DEPTH=3
MAX_CHILDREN=3
CHILD_ENDOWMENT_USD=1.00
REPLICATION_RESERVE_USD=1.00

# auto uses Docker when the agent image exists, otherwise an in-process body.
# docker-compose sets RUNTIME=docker.
RUNTIME=auto
AGENT_IMAGE=automaton:2
DOCKER_NETWORK=automaton_default
DOCKER_VOLUME=
ORCHESTRATOR_URL=http://orchestrator:4747

# auto uses SearXNG when SEARXNG_URL is set, else Brave, Tavily, or Exa if that key is set, else mock.
# SearXNG is the free option (self-hosted, no key). Brave, Tavily, and Exa have free tiers.
SEARCH_PROVIDER=auto
SEARXNG_URL=
SEARCH_COST_USD=0.002

# Shared headless browser. The orchestrator calls it. Agent containers do not.
SENSES_URL=http://senses:7070
SEE_PAGE_PRICE_USD=0.002
SEE_PAGE_SCREENSHOT_PRICE_USD=0.003
SEE_PAGE_HOURLY_LIMIT=30
# Polite crawl of one public site. Price is per page actually fetched. No API key.
CRAWL_PAGE_PRICE_USD=0.001
CRAWL_HOURLY_LIMIT=5
CRAWL_MAX_PAGES=20
# Public feeds. Price is per call. No API key. A reddit block still costs the fee.
READ_FEED_PRICE_USD=0.0005
READ_FEED_HOURLY_LIMIT=60
# The claim tool. Price per accepted claim; a rejected claim costs nothing but counts toward the hourly limit.
CLAIM_COST_USD=0.0001
CLAIM_HOURLY_LIMIT=30
REDDIT_USER_AGENT="AutomatonSenses/2.0 (key-free public JSON reader; no OAuth)"
# Local browser agent. Off until you set this to true. No Browser Use cloud key.
BROWSE_ENABLED=false
BROWSE_STEP_PRICE_USD=0.005
BROWSE_LLM_RESERVE_USD=0.05
BROWSE_HOURLY_LIMIT=3
BROWSE_MAX_STEPS=15
# Static pages and paid handler endpoints. Debited from the agent ledger.
PUBLISH_PAGE_PRICE_USD=0.001
SERVE_ENDPOINT_PRICE_USD=0.002
SERVE_MIN_PRICE_USD=0.001
SERVE_MAX_PRICE_USD=1.00
# Handler containers. The default image is AGENT_IMAGE, which is Node. Set HANDLER_IMAGE to a
# pinned tag only when that image has no Node, for example node:22.21.0-bookworm-slim.
HANDLER_TIMEOUT_MS=10000
HANDLER_QUEUE_TIMEOUT_MS=10000
# HANDLER_IMAGE=
# Host path mounted read-only into agent containers at /ref. Default is the repo ref/ directory.
REF_DIR=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=

# Live x402. On Base Sepolia the public facilitator is used when this is empty.
# Set FACILITATOR_PRIVATE_KEY (a wallet with gas ETH) to broadcast yourself instead.
X402_SETTLEMENT=auto
X402_FACILITATOR_URL=
FACILITATOR_PRIVATE_KEY=
# Same key can fund gas so a dead agent's USDC is not stuck. Falls back to FACILITATOR_PRIVATE_KEY.
GAS_FUNDER_PRIVATE_KEY=
GAS_TOPUP_WEI=50000000000000
GAS_MIN_WEI=20000000000000
REPORT_INTERVAL_MS=86400000
# Extra hosts the agents must not touch, comma-separated.
OWNER_DENY_HOSTS=

TURN_INTERVAL_MS=15000
# Clock jumps are allowed in dry-run so the demo can age a day in one request.
# ALLOW_CLOCK_CONTROL=false
